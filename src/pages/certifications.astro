---
import MainLayout from "../layouts/MainLayout.astro";
import Card from "../components/ui/Card.astro";

const animationStyles = `
  @keyframes fadeInUp {
    from {
      opacity: 0;
      transform: translateY(30px);
    }
    to {
      opacity: 1;
      transform: translateY(0);
    }
  }

  @keyframes slideInLeft {
    from {
      opacity: 0;
      transform: translateX(-30px);
    }
    to {
      opacity: 1;
      transform: translateX(0);
    }
  }

  @keyframes slideInRight {
    from {
      opacity: 0;
      transform: translateX(30px);
    }
    to {
      opacity: 1;
      transform: translateX(0);
    }
  }

  .animate-fade-in-up {
    animation: fadeInUp 0.6s ease-out forwards;
    opacity: 0;
  }

  .animate-slide-in-left {
    animation: slideInLeft 0.6s ease-out forwards;
    opacity: 0;
  }

  .animate-slide-in-right {
    animation: slideInRight 0.6s ease-out forwards;
    opacity: 0;
  }

  .scroll-animate {
    opacity: 0;
    transform: translateY(30px);
    transition: all 0.6s ease-out;
  }

  .scroll-animate.in-view {
    opacity: 1;
    transform: translateY(0);
  }
`;


const certifications = [
  {
    category: "Cybersecurity & Cyber Forensics Certifications",
    items: [
      {
        title: "Cybersecurity Professional Certification",
        description: "Covers fundamental cybersecurity concepts, network security, threat detection, and risk management."
      },
      {
        title: "Ethical Hacking Expert Certification",
        description: "Focuses on penetration testing, vulnerability assessments, and exploitation techniques."
      },
      {
        title: "Advanced Security Analyst Certification",
        description: "Covers advanced cyber defense, threat intelligence, digital forensics, and incident response."
      },
      {
        title: "Cyber Forensics Certifications",
        description: "Includes digital forensics essentials and advanced forensic investigation techniques."
      }
    ]
  },
  {
    category: "DevOps & DevSecOps Certifications",
    items: [
      {
        title: "Certified DevOps Engineer",
        description: "Covers CI/CD pipelines, cloud deployment, containerization (Docker & Kubernetes)."
      },
      {
        title: "Certified DevSecOps Specialist",
        description: "Focuses on integrating security into DevOps, automating security tools, and compliance."
      },
      {
        title: "Cloud Security & Compliance Certification",
        description: "Covers security best practices for AWS, Azure, and GCP, IAM, and compliance frameworks."
      },
      {
        title: "Infrastructure as Code & Automation",
        description: "Covers Terraform, Ansible, and infrastructure security automation."
      }
    ]
  },
  {
    category: "Web Development Certifications",
    items: [
      {
        title: "Certified Frontend Developer",
        description: "Teaches modern web development fundamentals using HTML, CSS, and JavaScript."
      },
      {
        title: "Angular Development Certification",
        description: "Covers Angular framework, TypeScript, and advanced UI components."
      },
      {
        title: "TypeScript Developer Certification",
        description: "Covers TypeScript and modern JavaScript features for scalable applications."
      },
      {
        title: "UI/UX Design Certification",
        description: "Covers wireframing, prototyping, user research, and design thinking."
      }
    ]
  }
];
---

<MainLayout title="Certifications & Career Pathways">
	<main class="space-y-20">
        <div class="py-8 px-4 mx-auto max-w-screen-xl lg:py-16 lg:px-3">
            <div class="mx-auto max-w-screen-md text-center mb-8 lg:mb-12">
                <div class="flex justify-center mb-4">
                  <div class="w-2 h-2 bg-orange-500 rounded-full mx-1 animate-fade-in-up" style="animation-delay: 0s;"></div>
                  <div class="w-2 h-2 bg-orange-500 rounded-full mx-1 animate-fade-in-up" style="animation-delay: 0.1s;"></div>
                  <div class="w-2 h-2 bg-orange-500 rounded-full mx-1 animate-fade-in-up" style="animation-delay: 0.2s;"></div>
                </div>
                <h2 class="mb-4 text-4xl tracking-tight font-extrabold text-gray-900 animate-fade-in-up" style="animation-delay: 0.3s;">Certifications & Career Pathways</h2>
                <p class="mb-5 font-light text-gray-500 sm:text-xl animate-fade-in-up" style="animation-delay: 0.4s;">Equip yourself with industry-recognized certifications and step into a thriving career in tech.</p>
                <div class="flex justify-center mt-6">
                  <div class="h-1 w-16 bg-orange-500 rounded-full animate-fade-in-up" style="animation-delay: 0.5s;"></div>
                </div>
            </div>

            {
              certifications.map((category, idx) => (
                <div class="mb-16 scroll-animate" style={`animation-delay: ${idx * 0.1}s;`}>
                  <div class="flex items-center gap-3 mb-8">
                    <div class="w-1 h-8 bg-orange-500 rounded-full"></div>
                    <h3 class="text-2xl tracking-tight font-bold text-gray-900">{category.category}</h3>
                  </div>
                  <div class="space-y-8 lg:grid lg:grid-cols-2 sm:gap-6 xl:gap-10 lg:space-y-0">
                    {
                      category.items.map((cert, itemIdx) => (
                        <div class="scroll-animate" style={`animation-delay: ${idx * 0.1 + itemIdx * 0.05}s;`}>
                          <Card isUnderline={true}>
                            <div class="flex flex-col p-6 relative">
                              <div class="absolute top-0 left-0 w-1 h-12 rounded-r"></div>
                              <h4 class="mb-3 text-xl font-semibold text-gray-900 pl-4">{cert.title}</h4>
                              <p class="font-light text-gray-600 text-base pl-4">{cert.description}</p>
                            </div>
                          </Card>
                        </div>
                      ))
                    }
                  </div>
                </div>
              ))
            }
        </div>
	</main>

  <style set:html={animationStyles}></style>
  
  <script>
    const observer = new IntersectionObserver((entries) => {
      entries.forEach((entry) => {
        if (entry.isIntersecting) {
          entry.target.classList.add("in-view");
        }
      });
    }, {
      threshold: 0.1,
    });

    document.querySelectorAll(".scroll-animate").forEach((el) => {
      observer.observe(el);
    });
  </script>
</MainLayout>