---
import MainLayout from "../layouts/MainLayout.astro";
---

<MainLayout title="Contact Us - Out O Box">
    <main class="min-h-screen py-20 px-4">
        <div class="max-w-4xl mx-auto">
            
            <!-- Header -->
            <div class="text-center mb-16 fade-in-up">
                <h1 class="text-4xl md:text-5xl font-bold mb-4">
                    Let's Talk
                </h1>
                <div class="w-20 h-1 bg-orange-500 mx-auto mb-6"></div>
                <p class="text-xl text-gray-600 dark:text-gray-300">
                    Tell us about your project or training needs
                </p>
            </div>

            <!-- Contact Form Card -->
            <div class="bg-white dark:bg-gray-800 rounded-3xl shadow-xl p-8 md:p-12 fade-in-up" style="animation-delay: 0.2s;">
                
                <form id="contactForm" class="space-y-6">
                    
                    <!-- Name & Email Row -->
                    <div class="grid md:grid-cols-2 gap-6">
                        <div class="slide-in-left" style="animation-delay: 0.3s;">
                            <label for="name" class="block mb-2 text-sm font-medium">
                                Your Name
                            </label>
                            <input 
                                type="text" 
                                id="name" 
                                name="name"
                                class="w-full px-4 py-3 bg-gray-50 dark:bg-gray-900 border-2 border-gray-200 dark:border-gray-700 rounded-xl focus:border-orange-500 focus:outline-none transition-all duration-300 focus:scale-[1.02]" 
                                placeholder="John Doe" 
                                required 
                            />
                        </div>

                        <div class="slide-in-right" style="animation-delay: 0.3s;">
                            <label for="email" class="block mb-2 text-sm font-medium">
                                Your Email
                            </label>
                            <input 
                                type="email" 
                                id="email" 
                                name="email"
                                class="w-full px-4 py-3 bg-gray-50 dark:bg-gray-900 border-2 border-gray-200 dark:border-gray-700 rounded-xl focus:border-orange-500 focus:outline-none transition-all duration-300 focus:scale-[1.02]" 
                                placeholder="john@example.com" 
                                required 
                            />
                        </div>
                    </div>

                    <!-- Subject -->
                    <div class="fade-in-up" style="animation-delay: 0.4s;">
                        <label for="subject" class="block mb-2 text-sm font-medium">
                            Subject
                        </label>
                        <input 
                            type="text" 
                            id="subject" 
                            name="subject"
                            class="w-full px-4 py-3 bg-gray-50 dark:bg-gray-900 border-2 border-gray-200 dark:border-gray-700 rounded-xl focus:border-orange-500 focus:outline-none transition-all duration-300 focus:scale-[1.02]" 
                            placeholder="Web Development / Cybersecurity Training / Other" 
                            required 
                        />
                    </div>

                    <!-- Message -->
                    <div class="fade-in-up" style="animation-delay: 0.5s;">
                        <label for="message" class="block mb-2 text-sm font-medium">
                            Message
                        </label>
                        <textarea 
                            id="message" 
                            name="message"
                            rows="6" 
                            class="w-full px-4 py-3 bg-gray-50 dark:bg-gray-900 border-2 border-gray-200 dark:border-gray-700 rounded-xl focus:border-orange-500 focus:outline-none transition-all duration-300 resize-none focus:scale-[1.01]" 
                            placeholder="Tell us more about what you need..."
                            required
                        ></textarea>
                    </div>

                    <!-- Submit Button -->
                    <div class="fade-in-up" style="animation-delay: 0.6s;">
                        <button 
                            type="submit" 
                            class="w-full md:w-auto px-8 py-4 bg-orange-500 hover:bg-orange-600 text-white font-semibold rounded-xl transition-all duration-300 hover:shadow-lg hover:shadow-orange-500/50 hover:scale-105 active:scale-95"
                        >
                            <span class="flex items-center justify-center gap-2">
                                <svg class="w-5 h-5" fill="currentColor" viewBox="0 0 24 24">
                                    <path d="M17.472 14.382c-.297-.149-1.758-.867-2.03-.967-.273-.099-.471-.148-.67.15-.197.297-.767.966-.94 1.164-.173.199-.347.223-.644.075-.297-.15-1.255-.463-2.39-1.475-.883-.788-1.48-1.761-1.653-2.059-.173-.297-.018-.458.13-.606.134-.133.298-.347.446-.52.149-.174.198-.298.298-.497.099-.198.05-.371-.025-.52-.075-.149-.669-1.612-.916-2.207-.242-.579-.487-.5-.669-.51-.173-.008-.371-.01-.57-.01-.198 0-.52.074-.792.372-.272.297-1.04 1.016-1.04 2.479 0 1.462 1.065 2.875 1.213 3.074.149.198 2.096 3.2 5.077 4.487.709.306 1.262.489 1.694.625.712.227 1.36.195 1.871.118.571-.085 1.758-.719 2.006-1.413.248-.694.248-1.289.173-1.413-.074-.124-.272-.198-.57-.347m-5.421 7.403h-.004a9.87 9.87 0 01-5.031-1.378l-.361-.214-3.741.982.998-3.648-.235-.374a9.86 9.86 0 01-1.51-5.26c.001-5.45 4.436-9.884 9.888-9.884 2.64 0 5.122 1.03 6.988 2.898a9.825 9.825 0 012.893 6.994c-.003 5.45-4.437 9.884-9.885 9.884m8.413-18.297A11.815 11.815 0 0012.05 0C5.495 0 .16 5.335.157 11.892c0 2.096.547 4.142 1.588 5.945L.057 24l6.305-1.654a11.882 11.882 0 005.683 1.448h.005c6.554 0 11.89-5.335 11.893-11.893a11.821 11.821 0 00-3.48-8.413Z"/>
                                </svg>
                                Send Message via WhatsApp
                            </span>
                        </button>
                    </div>
                </form>

                <!-- Divider -->
                <div class="relative my-12 fade-in-up" style="animation-delay: 0.7s;">
                    <div class="absolute inset-0 flex items-center">
                        <div class="w-full border-t-2 border-gray-200 dark:border-gray-700"></div>
                    </div>
                    <div class="relative flex justify-center text-sm">
                        <span class="px-6 bg-white dark:bg-gray-800 text-gray-500 font-medium">or contact us directly</span>
                    </div>
                </div>

                <!-- Contact Info -->
                <div class="grid grid-cols-1 md:grid-cols-2 gap-6">
                    <a href="https://wa.me/9400276663" 
                       target="_blank"
                       rel="noopener noreferrer"
                       class="flex items-center gap-4 p-6 bg-gray-50 dark:bg-gray-900 rounded-xl hover:bg-orange-50 dark:hover:bg-orange-950/20 transition-all duration-300 group hover:scale-105 hover:shadow-lg slide-in-right border-2 border-transparent hover:border-orange-500/20"
                       style="animation-delay: 0.8s;">
                        <div class="w-14 h-14 bg-orange-500 rounded-xl flex items-center justify-center flex-shrink-0 group-hover:scale-110 group-hover:rotate-6 transition-all duration-300 shadow-lg">
                            <svg class="w-7 h-7 text-white" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                                <path d="M17.472 14.382c-.297-.149-1.758-.867-2.03-.967-.273-.099-.471-.148-.67.15-.197.297-.767.966-.94 1.164-.173.199-.347.223-.644.075-.297-.15-1.255-.463-2.39-1.475-.883-.788-1.48-1.761-1.653-2.059-.173-.297-.018-.458.13-.606.134-.133.298-.347.446-.52.149-.174.198-.298.298-.497.099-.198.05-.371-.025-.52-.075-.149-.669-1.612-.916-2.207-.242-.579-.487-.5-.669-.51-.173-.008-.371-.01-.57-.01-.198 0-.52.074-.792.372-.272.297-1.04 1.016-1.04 2.479 0 1.462 1.065 2.875 1.213 3.074.149.198 2.096 3.2 5.077 4.487.709.306 1.262.489 1.694.625.712.227 1.36.195 1.871.118.571-.085 1.758-.719 2.006-1.413.248-.694.248-1.289.173-1.413-.074-.124-.272-.198-.57-.347m-5.421 7.403h-.004a9.87 9.87 0 01-5.031-1.378l-.361-.214-3.741.982.998-3.648-.235-.374a9.86 9.86 0 01-1.51-5.26c.001-5.45 4.436-9.884 9.888-9.884 2.64 0 5.122 1.03 6.988 2.898a9.825 9.825 0 012.893 6.994c-.003 5.45-4.437 9.884-9.885 9.884m8.413-18.297A11.815 11.815 0 0012.05 0C5.495 0 .16 5.335.157 11.892c0 2.096.547 4.142 1.588 5.945L.057 24l6.305-1.654a11.882 11.882 0 005.683 1.448h.005c6.554 0 11.89-5.335 11.893-11.893a11.821 11.821 0 00-3.48-8.413Z"/>
                            </svg>
                        </div>
                        <div class="flex-1 min-w-0">
                            <div class="font-normal text-lg text-gray-900 dark:text-orange group-hover:text-orange-600 dark:group-hover:text-orange-400 transition-colors mb-1">WhatsApp</div>
                            <div class="text-base text-gray-600 dark:text-gray-400 font-medium">+91 9400276663</div>
                        </div>
                    </a>

                    <a href="mailto:outobox@gmail.com"
                       class="flex items-center gap-4 p-6 bg-gray-50 dark:bg-gray-900 rounded-xl hover:bg-orange-50 dark:hover:bg-orange-950/20 transition-all duration-300 group hover:scale-105 hover:shadow-lg slide-in-right border-2 border-transparent hover:border-orange-500/20"
                       style="animation-delay: 0.8s;">
                        <div class="w-14 h-14 bg-orange-500 rounded-xl flex items-center justify-center flex-shrink-0 group-hover:scale-110 group-hover:rotate-6 transition-all duration-300 shadow-lg">
                            <svg class="w-7 h-7 text-white" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                                <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M3 8l7.89 5.26a2 2 0 002.22 0L21 8M5 19h14a2 2 0 002-2V7a2 2 0 00-2-2H5a2 2 0 00-2 2v10a2 2 0 002 2z"></path>
                            </svg>
                        </div>
                        <div class="flex-1 min-w-0">
                            <div class="font-normal text-lg text-gray-900 dark:text-orange group-hover:text-orange-600 dark:group-hover:text-orange-400 transition-colors mb-1">Email</div>
                            <div class="text-base text-gray-600 dark:text-gray-400 font-medium break-all">info@outobox.com</div>
                        </div>
                    </a>
                </div>

            </div>

        </div>
    </main>
</MainLayout>

<script>
    document.getElementById('contactForm')?.addEventListener('submit', function(e) {
        e.preventDefault();
        
        const name = (document.getElementById('name') as HTMLInputElement).value;
        const email = (document.getElementById('email') as HTMLInputElement).value;
        const subject = (document.getElementById('subject') as HTMLInputElement).value;
        const message = (document.getElementById('message') as HTMLTextAreaElement).value;
        
        const whatsappMessage = `*New Inquiry from Out O Box*%0A%0A*Name:* ${encodeURIComponent(name)}%0A*Email:* ${encodeURIComponent(email)}%0A*Subject:* ${encodeURIComponent(subject)}%0A%0A*Message:*%0A${encodeURIComponent(message)}`;
        
        const whatsappNumber = '+919400276663';
        
        window.open(`https://wa.me/${whatsappNumber}?text=${whatsappMessage}`, '_blank');
    });

    // Intersection Observer for scroll animations
    const observerOptions = {
        threshold: 0.1,
        rootMargin: '0px 0px -50px 0px'
    };

    const observer = new IntersectionObserver((entries) => {
        entries.forEach(entry => {
            if (entry.isIntersecting) {
                entry.target.classList.add('animate');
            }
        });
    }, observerOptions);

    // Observe all animated elements
    document.addEventListener('DOMContentLoaded', () => {
        const animatedElements = document.querySelectorAll('.fade-in-up, .slide-in-left, .slide-in-right');
        animatedElements.forEach(el => observer.observe(el));
    });
</script>

<style>
    /* Base animation states */
    .fade-in-up,
    .slide-in-left,
    .slide-in-right {
        opacity: 0;
        animation-fill-mode: forwards;
    }

    /* Fade in up animation */
    .fade-in-up {
        transform: translateY(30px);
    }

    .fade-in-up.animate {
        animation: fadeInUp 0.6s ease-out forwards;
    }

    @keyframes fadeInUp {
        to {
            opacity: 1;
            transform: translateY(0);
        }
    }

    /* Slide in from left */
    .slide-in-left {
        transform: translateX(-30px);
    }

    .slide-in-left.animate {
        animation: slideInLeft 0.6s ease-out forwards;
    }

    @keyframes slideInLeft {
        to {
            opacity: 1;
            transform: translateX(0);
        }
    }

    /* Slide in from right */
    .slide-in-right {
        transform: translateX(30px);
    }

    .slide-in-right.animate {
        animation: slideInRight 0.6s ease-out forwards;
    }

    @keyframes slideInRight {
        to {
            opacity: 1;
            transform: translateX(0);
        }
    }

    /* Form input focus effects */
    input:focus, 
    textarea:focus {
        outline: none;
    }

    /* Smooth transitions for all interactive elements */
    button,
    a,
    input,
    textarea {
        transition: all 0.3s ease;
    }

    /* Pulse animation for submit button */
    @keyframes pulse {
        0%, 100% {
            box-shadow: 0 0 0 0 rgba(249, 115, 22, 0.4);
        }
        50% {
            box-shadow: 0 0 0 10px rgba(249, 115, 22, 0);
        }
    }

    button[type="submit"]:hover {
        animation: pulse 2s infinite;
    }
</style>