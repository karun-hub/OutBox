---
import s2 from "../../assets/company/sed.png";
import s3 from "../../assets/company/paris.png";
import s4 from "../../assets/company/tang.png";
import s5 from "../../assets/company/ben.png";
import s6 from "../../assets/company/good.png";
import Section from "./Section.astro";
import SponsorsCarousel from "./SponsorsCarousel";

const sponsors = [
  { logo: s5.src, alt: "benoy", size: "h-20" },
  { logo: s4.src, alt: "tand", larger: true },
  { logo: s3.src, alt: "paris logo", larger: true },
  { logo: s2.src, alt: "sed logo", larger: true },
  { logo: s6.src, alt: "Goodwill logo", larger: true, size:"h-20" },

];
---

<Section id="sponsors">
  <SponsorsCarousel sponsors={sponsors} client:load />
</Section>